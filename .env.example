# ── LLM — Gemini (FREE) ───────────────────────────────────────────────────────
# Get key: https://aistudio.google.com → "Get API key"
# Free limits: 1500 req/day, 15 req/min (2.5 Flash)
GEMINI_API_KEY=your_gemini_key_here
LLM_BACKEND=gemini
LLM_MODEL=gemini-2.5-flash-preview-05-20

# ── LLM — Local alternatives (no key needed) ─────────────────────────────────
# Ollama:
# LLM_BACKEND=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3
# LLM_API_KEY=EMPTY

# vLLM on cluster:
# LLM_BACKEND=openai_compat
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_API_KEY=EMPTY

# ── Optional: CORE API key (better full-text coverage) ───────────────────────
# https://core.ac.uk/api-keys
# CORE_API_KEY=your_core_key_here

# ── Gemini rate-limit overrides ───────────────────────────────────────────────
# GEMINI_RPM=14      # requests per minute  (hard limit: 15)
# GEMINI_RPD=1490    # requests per day     (hard limit: 1500)
