# ── LLM — pick one ───────────────────────────────────────────────────────────

# Option A: Gemini 2.0 Flash (FREE — 1500 req/day)
# Get key: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=your_gemini_key_here
LLM_BACKEND=gemini
LLM_MODEL=gemini-2.0-flash

# Option B: Ollama (fully local, no key)
# Run: ollama pull llama3.3 && ollama serve
# LLM_BACKEND=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3
# LLM_API_KEY=EMPTY

# Option C: vLLM on a cluster (Qwen, Mistral, etc.)
# LLM_BACKEND=openai_compat
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_API_KEY=EMPTY

# Option D: Anthropic (paid)
# LLM_BACKEND=anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-...

# ── Optional: free CORE API key (10k req/day without key anyway) ─────────────
# https://core.ac.uk/api-keys
# CORE_API_KEY=your_core_key_here

# ── Gemini rate-limit overrides (safe defaults already set in code) ───────────
# GEMINI_RPM=14      # requests per minute  (hard limit: 15)
# GEMINI_RPD=1490    # requests per day     (hard limit: 1500)
